# Neon PostgreSQL Connection URL
DATABASE_URL="postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Set to false to skip Elasticsearch and always use the PostgreSQL fallback
ELASTICSEARCH_ENABLED=true

# Elasticsearch Node & Authentication
ELASTICSEARCH_NODE="http://localhost:9200"
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_API_KEY=""
ELASTICSEARCH_USERNAME=""
ELASTICSEARCH_USER=""
ELASTICSEARCH_PASSWORD=""

# Flask Backend Configuration
FLASK_ENV="development"
PORT=5000
SECRET_KEY="replace-with-a-secure-random-secret"
# Allowed browser origins for /api/* (comma-separated). "*" = any; in production use your frontend URL
CORS_ORIGINS="*"

# React Frontend Configuration
VITE_API_BASE_URL="http://localhost:5000"
